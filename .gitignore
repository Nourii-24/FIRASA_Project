# Virtual environment, never commit this
dashboard/.venv/
__pycache__/
*.pyc
.DS_Store

# Streamlit secrets (API keys etc.), if you add any later
dashboard/.streamlit/secrets.toml

# Raw EDA data does NOT belong in this repo: too large for GitHub (train/test
# parquet files can be hundreds of MB), and the notebooks already read them
# from Google Drive, not from a local copy. Only the small, exported dashboard
# files (dashboard/data/*.csv) are meant to be tracked.
*.parquet
